# KOMA settings.
# GitHub secrets are only VPS_HOST, VPS_USER, and VPS_SSH_PRIVATE_KEY.
# Everything else stays in this file. Do not commit .env.
#
# Local:  copy this file to .env
# Server: this file is /usr/src/koma_miniApp/KOMA/.env. Edit the values marked "Server".
#         Later deploys leave that file alone.

# --- App ---

# Local: development. Server: production
NODE_ENV=development

PORT=3000

# Password the API uses to sign login tokens. You invent it. At least 16 characters.
# Server: replace the placeholder. Do not reuse this example string.
JWT_SECRET=replace-with-a-long-random-string

# Token from BotFather.
TELEGRAM_BOT_TOKEN=

# Address of the Mini App.
# Local:  http://localhost:5173
# Server: https://koma.tereshkovych.com.ua
TELEGRAM_WEBAPP_URL=http://localhost:5173

# Browser origin allowed to call the API. Same address as TELEGRAM_WEBAPP_URL.
WEB_ORIGIN=http://localhost:5173

# Local login without Telegram. The server ignores this when NODE_ENV=production.
ALLOW_DEV_AUTH=true

# --- Database ---

# Local Prisma only (npm run dev, prisma migrate). Points at MySQL on this PC.
DATABASE_URL=mysql://koma:koma@localhost:3306/koma

# Docker Compose database passwords. Letters and digits only.
# On the server, keep these the same after the first successful start.
MYSQL_PASSWORD=koma
MYSQL_ROOT_PASSWORD=root

# --- Sources ---

COMX_BASE_URL=https://com-x.life
MANGALIB_BASE_URL=https://mangalib.me
MANGALIB_API_URL=https://api.cdnlibs.org
IMAGE_HOST_ALLOWLIST=com-x.life,cdnlibs.org,imglib.info,mangalib.me
SOURCE_TIMEOUT_MS=12000

# --- Process ---

LOG_LEVEL=info
PROCESS_ROLE=api
RUN_SCHEDULER=false
REDIS_URL=
